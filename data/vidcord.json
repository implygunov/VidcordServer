    },
    {
      "id": "msg_2",
      "channel_id": "chn_cp_general",
      "server_id": "srv_cyberpunk",
      "user_id": "usr_cyber",
      "content": "Just slotted the Militech \"Falcon\" Sandevistan with 3x heat sinks. The time dilation slowdown feels insane during boss encounters 🔥",
